<?xml version="1.0"?>
<!-- puzzle_E: standalone static model from E.step.
     Mesh in millimetres (scale 0.001). Link origin = STEP-file origin, unchanged.
     Mass/inertia assume density 1.24 g/cm^3 -> 43.6 g (material not given in the STEP). -->
<robot name="puzzle_E">
  <material name="puzzle_E_color"><color rgba="0.65 0.40 0.80 1.0"/></material>
  <link name="puzzle_E_link">
    <visual>
      <geometry><mesh filename="meshes/puzzle_E.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="puzzle_E_color"/>
    </visual>
    <collision>
      <geometry><mesh filename="meshes/puzzle_E.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.002005 0.003258 0.109268" rpy="0 0 0"/>
      <mass value="0.04361"/>
      <inertia ixx="1.9888e-04" ixy="-2.8162e-05" ixz="-1.4096e-05" iyy="1.5131e-04" iyz="-3.1473e-05" izz="7.8345e-05"/>
    </inertial>
  </link>
</robot>
