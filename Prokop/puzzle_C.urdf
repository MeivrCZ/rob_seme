<?xml version="1.0"?>
<!-- puzzle_C: standalone static model from C.step.
     Mesh in millimetres (scale 0.001). Link origin = STEP-file origin, unchanged.
     Mass/inertia assume density 1.24 g/cm^3 -> 32.0 g (material not given in the STEP). -->
<robot name="puzzle_C">
  <material name="puzzle_C_color"><color rgba="0.30 0.75 0.35 1.0"/></material>
  <link name="puzzle_C_link">
    <visual>
      <geometry><mesh filename="meshes/puzzle_C.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="puzzle_C_color"/>
    </visual>
    <collision>
      <geometry><mesh filename="meshes/puzzle_C.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.030210 -0.016878 0.093376" rpy="0 0 0"/>
      <mass value="0.03203"/>
      <inertia ixx="1.2118e-04" ixy="-1.0128e-05" ixz="3.6953e-05" iyy="1.2306e-04" iyz="3.2969e-05" izz="3.0127e-05"/>
    </inertial>
  </link>
</robot>
