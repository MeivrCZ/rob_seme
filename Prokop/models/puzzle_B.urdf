<?xml version="1.0"?>
<!-- puzzle_B: standalone static model from B.step.
     Mesh in millimetres (scale 0.001). Link origin = STEP-file origin, unchanged.
     Mass/inertia assume density 1.24 g/cm^3 -> 30.5 g (material not given in the STEP). -->
<robot name="puzzle_B">
  <material name="puzzle_B_color"><color rgba="0.25 0.55 0.85 1.0"/></material>
  <link name="puzzle_B_link">
    <visual>
      <geometry><mesh filename="meshes/puzzle_B.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="puzzle_B_color"/>
    </visual>
    <collision>
      <geometry><mesh filename="meshes/puzzle_B.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.028327 -0.000374 0.094810" rpy="0 0 0"/>
      <mass value="0.03049"/>
      <inertia ixx="1.0602e-04" ixy="-3.2288e-07" ixz="-4.8470e-05" iyy="1.3211e-04" iyz="-1.0961e-06" izz="2.6860e-05"/>
    </inertial>
  </link>
</robot>
