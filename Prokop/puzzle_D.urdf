<?xml version="1.0"?>
<!-- puzzle_D: standalone static model from D.step.
     Mesh in millimetres (scale 0.001). Link origin = STEP-file origin, unchanged.
     Mass/inertia assume density 1.24 g/cm^3 -> 31.8 g (material not given in the STEP). -->
<robot name="puzzle_D">
  <material name="puzzle_D_color"><color rgba="0.95 0.75 0.20 1.0"/></material>
  <link name="puzzle_D_link">
    <visual>
      <geometry><mesh filename="meshes/puzzle_D.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="puzzle_D_color"/>
    </visual>
    <collision>
      <geometry><mesh filename="meshes/puzzle_D.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.008500 -0.000358 0.094405" rpy="0 0 0"/>
      <mass value="0.03182"/>
      <inertia ixx="9.9725e-05" ixy="-9.6890e-08" ixz="-2.9159e-05" iyy="1.2531e-04" iyz="-1.0915e-06" izz="2.6373e-05"/>
    </inertial>
  </link>
</robot>
