<?xml version="1.0"?>
<!-- puzzle_A: standalone static model from A.step.
     Mesh in millimetres (scale 0.001). Link origin = STEP-file origin, unchanged.
     Mass/inertia assume density 1.24 g/cm^3 -> 26.9 g (material not given in the STEP). -->
<robot name="puzzle_A">
  <material name="puzzle_A_color"><color rgba="0.85 0.30 0.25 1.0"/></material>
  <link name="puzzle_A_link">
    <visual>
      <geometry><mesh filename="meshes/puzzle_A.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="puzzle_A_color"/>
    </visual>
    <collision>
      <geometry><mesh filename="meshes/puzzle_A.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.000000 -0.000424 0.092111" rpy="0 0 0"/>
      <mass value="0.02689"/>
      <inertia ixx="1.0285e-04" ixy="3.6775e-20" ixz="2.9077e-20" iyy="1.0292e-04" iyz="-1.0653e-06" izz="7.7365e-07"/>
    </inertial>
  </link>
</robot>
