<?xml version="1.0"?>
<!-- crs_adapter: standalone static model from CRS_adapter.step.
     Mesh in millimetres (scale 0.001). Link origin = STEP-file origin, unchanged.
     Mass/inertia assume density 2.70 g/cm^3 -> 94.7 g (material not given in the STEP). -->
<robot name="crs_adapter">
  <material name="crs_adapter_color"><color rgba="0.12 0.22 0.60 1.0"/></material>
  <link name="crs_adapter_link">
    <visual>
      <geometry><mesh filename="meshes/crs_adapter.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="crs_adapter_color"/>
    </visual>
    <collision>
      <geometry><mesh filename="meshes/crs_adapter.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.000000 -0.000027 -0.002882" rpy="0 0 0"/>
      <mass value="0.09474"/>
      <inertia ixx="2.9580e-05" ixy="-3.8781e-16" ixz="-2.1513e-15" iyy="2.9974e-05" iyz="-3.0108e-10" izz="5.7955e-05"/>
    </inertial>
  </link>
</robot>
